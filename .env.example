# =================================
# ISRAEL KITCHEN - ENVIRONMENT TEMPLATE
# =================================
# 
# SECURITY NOTICE:
# - NEVER commit actual .env files to version control
# - Use strong, unique values for all secrets
# - Rotate secrets regularly
# - Use environment-specific values
#
# Copy this file to .env and fill in your actual values
# =================================

# =================================
# DATABASE CONFIGURATION
# =================================
# Use a strong PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?options
DATABASE_URL="postgresql://username:password@localhost:5432/israel_kitchen_dev"

# =================================
# NEXTAUTH CONFIGURATION  
# =================================
# Your application URL (change for production)
NEXTAUTH_URL="http://localhost:3000"

# CRITICAL: Generate a secure secret using:
# openssl ran -base64 32
# OR: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="REPLACE_WITH_SECURE_32_CHAR_SECRET"

# Development only - REMOVE in production
NEXTAUTH_DEBUG="false"

# =================================
# STRIPE PAYMENT CONFIGURATION
# =================================
# Get these from your Stripe Dashboard
# Test keys start with pk_test_ and sk_test_
# Live keys start with pk_live_ and sk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY"
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"

# Stripe webhook secret (for webhook validation)
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET"

# =================================
# GOOGLE PAY CONFIGURATION
# =================================
# Your Google Pay merchant ID
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID="YOUR_GOOGLE_PAY_MERCHANT_ID"

# =================================
# EMAIL CONFIGURATION (Optional)
# =================================
# For sending order confirmations, etc.
EMAIL_FROM="noreply@israelkitchen.com"
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"

# =================================
# SECURITY HEADERS & CSRF
# =================================
# Only use in development - NEVER in production
# NEXTAUTH_SKIP_CSRF_CHECK="skip"

# =================================
# LOGGING & MONITORING
# =================================
# Log level: error, warn, info, debug
LOG_LEVEL="info"

# Sentry DSN for error tracking (optional)
# SENTRY_DSN="your-sentry-dsn"

# =================================
# FEATURE FLAGS (Optional)
# =================================
# Enable/disable features
FEATURE_ADMIN_PANEL="true"
FEATURE_GOOGLE_PAY="true"
FEATURE_EMAIL_NOTIFICATIONS="true"

# =================================
# DEVELOPMENT SETTINGS
# =================================
# Skip environment validation during build
# SKIP_ENV_VALIDATION="false"